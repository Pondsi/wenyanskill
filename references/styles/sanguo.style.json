{
  "id": "sanguo",
  "name": "三国·谋士将帅风",
  "era": "汉末",
  "address_system": {
    "self": ["某", "在下", "亮", "臣", "末将"],
    "other": ["主公", "将军", "军师", "先生", "阁下"],
    "authority": ["丞相", "将军", "主公", "天子"],
    "time_words": ["今", "此时", "方才", "此刻"]
  },
  "forbidden_patterns": [
    "互联网|APP|电脑|手机|OK",
    "AI|人工智能|算法|系统",
    "数据|信息|流量|用户",
    "bug|代码|程序|debug",
    "效率|优化|方案一"
  ],
  "forbidden_replacements": {
